[Unit]
Description=shrink-your-shit video re-encoder
After=network-online.target
Wants=network-online.target

[Service]
User=syp
Group=syp
EnvironmentFile=/etc/default/shrink-your-shit
ExecStart=/usr/local/bin/shrink-your-shit
Restart=on-failure
RestartSec=5
# Be polite to everything else in the container/host.
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
